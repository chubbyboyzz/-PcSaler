@model PcSaler.Models.PCBuildDetailViewModel

@{
    ViewData["Title"] = Model.PCBuildName;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "PcBuild")">PC Build</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.PCBuildName</li>
        </ol>
    </nav>

    <div class="row g-5">
        <!-- Cột Trái: Ảnh và Giá -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm sticky-top" style="top: 90px; z-index: 1;">
                <div class="p-3">
                    <img src="~/images/pcbuilds/@(Model.ImageURL ?? "no-img.png")"
                         class="img-fluid rounded w-100 border"
                         alt="@Model.PCBuildName">
                </div>
                <div class="card-body">
                    <h2 class="fw-bold mb-3">@Model.PCBuildName</h2>

                    <div class="d-flex align-items-center mb-3">
                        <h3 class="text-danger fw-bold me-3 mb-0">@Model.TotalPrice.ToString("#,##0") đ</h3>
                        <span class="badge bg-success">Còn hàng</span>
                    </div>

                    <p class="text-muted small">
                        <i class="fa-solid fa-check-circle text-success me-1"></i> Bảo hành chính hãng 36 tháng<br />
                        <i class="fa-solid fa-check-circle text-success me-1"></i> Hỗ trợ trả góp 0%<br />
                        <i class="fa-solid fa-check-circle text-success me-1"></i> Miễn phí lắp đặt & cài Win
                    </p>

                    <div class="d-grid gap-2 mt-4">
                        <button class="btn btn-danger btn-lg fw-bold text-uppercase py-3" onclick="addToCart(@Model.PCBuildID)">
                            <i class="fa-solid fa-cart-shopping me-2"></i> Mua Ngay
                        </button>
                        <button class="btn btn-outline-primary fw-semibold">
                            <i class="fa-solid fa-phone me-2"></i> Tư vấn: 1900 xxxx
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột Phải: Chi tiết linh kiện -->
        <div class="col-lg-7">
            <h4 class="fw-bold border-bottom pb-2 mb-4"><i class="fa-solid fa-microchip me-2"></i>Chi tiết cấu hình</h4>

            <div class="table-responsive shadow-sm rounded border">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width: 50px;">#</th>
                            <th scope="col" style="width: 120px;">Linh kiện</th>
                            <th scope="col">Tên sản phẩm</th>
                            <th scope="col" class="text-center" style="width: 80px;">SL</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Components != null && Model.Components.Any())
                        {
                            foreach (var comp in Model.Components)
                            {
                                <tr>
                                    <td class="text-center">
                                        <!-- Icon minh họa theo loại linh kiện -->
                                        @if (comp.ComponentType == "CPU")
                                        {
                                            <i class="fa-solid fa-microchip text-primary"></i>
                                        }
                                        else if (comp.ComponentType == "VGA")
                                        {

                                            <i class="fa-solid fa-gamepad text-danger"></i>
                                        }
                                        else if (comp.ComponentType == "RAM")
                                        {

                                            <i class="fa-solid fa-memory text-success"></i>
                                        }
                                        else if (comp.ComponentType.Contains("Main"))
                                        {

                                            <i class="fa-solid fa-chess-board text-info"></i>
                                        }
                                        else
                                        {

                                            <i class="fa-solid fa-screwdriver-wrench text-secondary"></i>
                                        }
                                    </td>
                                    <td class="fw-bold text-secondary small">@comp.ComponentType</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="~/images/products/@(comp.ImageURL ?? "no-img.png")"
                                                 width="40" height="40"
                                                 class="rounded me-2 border object-fit-cover">
                                            <a href="@Url.Action("Details", "Product", new { id = comp.ProductID })" class="text-decoration-none text-dark fw-semibold">
                                                @comp.ProductName
                                            </a>
                                        </div>
                                    </td>
                                    <td class="text-center fw-bold">x@(comp.Quantity)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mô tả thêm -->
            <div class="mt-5">
                <h4 class="fw-bold border-bottom pb-2 mb-3">Mô tả sản phẩm</h4>
                <div class="bg-light p-4 rounded text-secondary">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        @Html.Raw(Model.Description.Replace("\n", "<br>"))
                    }
                    else
                    {
                        <span>Đang cập nhật mô tả...</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function addToCart(pcId) {
            // Gọi API thêm vào giỏ hàng (Logic bạn đã có ở các bài trước)
            // Ví dụ này chỉ alert mô phỏng
            // Trong thực tế, bạn gọi fetch('/api/APICart/add', ...) với ItemType = 'PCBUILD'

            alert("Đã thêm bộ PC (ID: " + pcId + ") vào giỏ hàng!\n(Tính năng này cần backend xử lý ItemType='PCBUILD')");
        }
    </script>
}
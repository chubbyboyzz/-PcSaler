@model IEnumerable<PcSaler.Models.PCBuildDetailViewModel>

@{
    ViewData["Title"] = "PC Build - Máy Bộ Cấu Hình Sẵn";
}

<link rel="stylesheet" href="~/css/pc-build-list.css" asp-append-version="true" />

<div class="tech-page-container">

    <div class="tech-banner">
        <h1>PC GAMING & WORKSTATION</h1>
        <p>Cấu hình tối ưu - Hiệu năng đỉnh cao - Bảo hành trọn gói</p>
    </div>

    <div class="tech-grid">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                // --- KHỐI LOGIC XỬ LÝ ẢNH (GIỮ NGUYÊN) ---
                string finalImg = "/images/no-image.png";
                if (!string.IsNullOrEmpty(item.ImageURL))
                {
                    if (item.ImageURL.StartsWith("/"))
                    {
                        finalImg = item.ImageURL;
                    }
                    else
                    {
                        finalImg = $"/images/pcbuilds/{item.ImageURL}";
                    }
                }
                // -------------------------------------------

                // Thẻ Card Custom
                <div class="tech-item-card">
                    <div class="tech-img-wrapper">
                        <span class="tech-badge">HOT</span>
                        <a href="@Url.Action("Details", "PcBuild", new { id = item.PCBuildID })">
                            <img src="@finalImg" alt="@item.PCBuildName" onerror="this.onerror=null; this.src='/images/no-image.png';">
                        </a>
                    </div>

                    <div class="tech-content">
                        <a href="@Url.Action("Details", "PcBuild", new { id = item.PCBuildID })" class="tech-title">
                            @item.PCBuildName
                        </a>

                        <div class="tech-price">
                            @item.TotalPrice.ToString("#,##0") đ
                        </div>

                        <a href="@Url.Action("Details", "PcBuild", new { id = item.PCBuildID })" class="tech-btn-action">
                            <i class="fa-solid fa-eye"></i> Xem cấu hình chi tiết
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="tech-empty">
                <i class="fa-solid fa-ghost"></i>
                <h3>Chưa có bộ PC nào được cập nhật.</h3>
            </div>
        }
    </div>
</div>
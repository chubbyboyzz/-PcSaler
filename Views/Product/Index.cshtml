@* File: Views/Product/Index.cshtml *@
@model IEnumerable<PcSaler.Models.ProductListViewModel>

@{
    ViewData["Title"] = ViewBag.CurrentCategory;
}

<div class="container mt-4">
    <h3 class="fw-bold text-primary text-uppercase mb-4 border-bottom pb-2">
        @(ViewBag.CurrentCategory ?? "Danh sách sản phẩm")
    </h3>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-3 col-sm-6 mb-4">
                    <div class="card h-100 shadow-sm border-0 product-card">

                        @{
                            string finalImg = "/images/no-image.png"; // Mặc định .jpg

                            if (!string.IsNullOrEmpty(item.ImageURL))
                            {
                                // Nếu DB lưu đường dẫn full (có dấu /) -> Dùng luôn
                                if (item.ImageURL.StartsWith("/"))
                                {
                                    finalImg = item.ImageURL;
                                }
                                // Nếu DB chỉ lưu tên file -> Tự động thêm folder products
                                else
                                {
                                    string fileName = System.IO.Path.GetFileName(item.ImageURL);
                                    finalImg = "/images/products/" + fileName;
                                }
                            }
                        }

                        <img src="@finalImg"
                             class="card-img-top p-3"
                             alt="@item.ProductName"
                             style="height: 200px; object-fit: contain;"
                             onerror="this.onerror=null; this.src='/images/no-image.png';">

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title" style="font-size: 1rem; height: 2.5em; overflow: hidden;">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductID" class="text-decoration-none text-dark fw-bold">
                                    @item.ProductName
                                </a>
                            </h5>

                            <p class="card-text text-danger fw-bold mt-auto fs-5">
                                @item.Price.ToString("#,##0") ₫
                            </p>

                            <div class="d-grid gap-2 mt-2">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductID" class="btn btn-outline-primary btn-sm">
                                    Xem chi tiết
                                </a>
                                <button class="btn btn-primary btn-sm" onclick="addToCart(@item.ProductID, 'PRODUCT')">
                                    <i class="fa-solid fa-cart-plus"></i> Thêm vào giỏ
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="fa-solid fa-box-open fa-3x text-muted mb-3"></i>
                <p class="text-muted fs-5">Không tìm thấy sản phẩm nào trong danh mục này.</p>
                <a href="/" class="btn btn-secondary mt-3">Quay lại trang chủ</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Copy lại hàm addToCart từ trang chủ sang đây để nút Thêm hoạt động
        // (Hoặc nếu ông để hàm này trong site.js chung thì không cần copy lại)
        var isUserLoggedIn = @((User.Identity?.IsAuthenticated ?? false).ToString().ToLower());

        function addToCart(id, type) {
            // ... (Logic giống hệt trang Home)
             if (isUserLoggedIn) {
                fetch('/api/APICart/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ItemID: id, ItemType: type, Quantity: 1 })
                }).then(res => {
                    if (res.ok) {
                        Swal.fire({icon: 'success', title: 'Thành công', text: 'Đã thêm vào giỏ', timer: 1000, showConfirmButton: false});
                        updateHeaderCartCount(); // Hàm này nằm ở _Layout
                    }
                });
            } else {
                let cart = JSON.parse(localStorage.getItem('guest_cart')) || [];
                let item = cart.find(x => x.ItemID == id && x.ItemType == type);
                if(item) item.Quantity++; else cart.push({ItemID: id, ItemType: type, Quantity: 1});
                localStorage.setItem('guest_cart', JSON.stringify(cart));
                Swal.fire({icon: 'success', title: 'Thành công', text: 'Đã thêm vào giỏ', timer: 1000, showConfirmButton: false});
                updateHeaderCartCount();
            }
        }
    </script>
}
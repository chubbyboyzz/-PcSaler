@model PcSaler.Models.ProductListViewModel
@{
    ViewData["Title"] = Model.ProductName;
}

<div class="row">
    <div class="col-md-6">
        @{
            // 1. Logic xử lý đường dẫn ảnh
            string finalImg = "/images/no-image.png";

            if (!string.IsNullOrEmpty(Model.ImageURL))
            {
                if (Model.ImageURL.StartsWith("/"))
                {
                    finalImg = Model.ImageURL;
                }
                else
                {
                    finalImg = "/images/products/" + Model.ImageURL;
                }
            }
        }

        <img src="@finalImg"
             class="img-fluid rounded shadow-sm"
             alt="@Model.ProductName"
             style="width: 100%; object-fit: contain;"
             onerror="this.onerror=null; this.src='/images/no-image.png';" />
    </div>

    <div class="col-md-6">
        <h3 class="fw-bold text-primary">@Model.ProductName</h3>
        <p class="text-muted"><i class="fa-solid fa-layer-group me-1"></i> @Model.CategoryName</p>

        <h3 class="text-danger fw-bold mb-4">@Model.Price.ToString("N0") ₫</h3>

        <form id="addToCartForm">
            <input type="hidden" name="ItemID" value="@Model.ProductID" />
            <input type="hidden" name="Quantity" value="1" />
            <input type="hidden" name="ItemType" value="PRODUCT" />

            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm" id="addToCartButton">
                <i class="fa-solid fa-cart-plus me-2"></i> Thêm vào giỏ
            </button>
        </form>

        <h5 class="mt-5 border-bottom pb-2">Cấu hình chi tiết</h5>
        <table class="table table-striped table-hover mt-3 small">
            <tbody>
                <tr><th style="width: 150px;">Hãng sản xuất</th><td>@Model.Brand</td></tr>
                <tr><th>Model</th><td>@Model.Model</td></tr>
                <tr><th>Bảo hành</th><td>@Model.WarrantyMonths tháng</td></tr>
                <tr><th>Ngày ra mắt</th><td>@Model.ReleaseDate?.ToString("dd/MM/yyyy")</td></tr>
                <tr><th>Thông số kỹ thuật</th><td>@Html.Raw(Model.Specifications)</td></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Lấy trạng thái đăng nhập từ Server render ra
        const isAuthenticated = @(User.Identity.IsAuthenticated.ToString().ToLower());

        document.getElementById('addToCartForm').addEventListener('submit', function(e) {
            e.preventDefault();

            // Lấy dữ liệu từ form
            const formData = new FormData(e.target);
            const data = {};
            formData.forEach((value, key) => (data[key] = value));

            // Chuyển đổi dữ liệu số
            data.ItemID = parseInt(data.ItemID);
            data.Quantity = parseInt(data.Quantity);

            const button = document.getElementById('addToCartButton');
            const originalText = button.innerHTML; // Lưu cả icon

            // Hiệu ứng Loading
            button.disabled = true;
            button.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Đang xử lý...';

            if (isAuthenticated) {
                // === THÀNH VIÊN (GỌI API) ===
                addToDatabase(data, button, originalText);
            } else {
                // === KHÁCH VÃNG LAI (LOCAL STORAGE) ===
                // Giả lập độ trễ 500ms cho giống thật
                setTimeout(() => {
                    addToLocalStorage(data);
                    button.disabled = false;
                    button.innerHTML = originalText;
                }, 500);
            }
        });

        // HÀM XỬ LÝ KHÁCH VÃNG LAI
        function addToLocalStorage(newItem) {
            let cart = JSON.parse(localStorage.getItem('guest_cart')) || [];

            // Lấy thêm thông tin chi tiết từ giao diện để lưu (cho đẹp Cart)
            const productName = document.querySelector('h3').innerText;
            // Lấy giá tiền, bỏ chữ 'đ' và dấu phẩy/chấm
            const priceText = document.querySelector('.text-danger').innerText.replace(/[^\d]/g, '');
            const price = parseInt(priceText);
            const imageUrl = document.querySelector('.img-fluid').getAttribute('src');

            const existingItemIndex = cart.findIndex(item => item.ItemID === newItem.ItemID && item.ItemType === newItem.ItemType);

            if (existingItemIndex > -1) {
                cart[existingItemIndex].Quantity += newItem.Quantity;
            } else {
                newItem.ProductName = productName;
                newItem.Price = price;
                newItem.ImageURL = imageUrl;
                cart.push(newItem);
            }

            localStorage.setItem('guest_cart', JSON.stringify(cart));

            // Cập nhật số trên menu (Hàm này nằm bên _Layout)
            if (typeof updateHeaderCartCount === "function") {
                updateHeaderCartCount();
            }

            // [THAY ĐỔI] Dùng SweetAlert thay alert thường
            Swal.fire({
                icon: 'success',
                title: 'Thêm thành công!',
                text: 'Sản phẩm đã được thêm vào giỏ hàng của bạn.',
                showConfirmButton: false,
                timer: 1500
            });
        }

        // HÀM XỬ LÝ THÀNH VIÊN
        function addToDatabase(data, button, originalText) {
            fetch('/api/APICart/add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
            .then(response => {
                if (response.ok) {
                    // Cập nhật Header
                    if (typeof updateHeaderCartCount === "function") updateHeaderCartCount();

                    // [THAY ĐỔI] Thông báo đẹp
                    Swal.fire({
                        icon: 'success',
                        title: 'Tuyệt vời!',
                        text: 'Sản phẩm đã được đồng bộ vào tài khoản của bạn.',
                        showConfirmButton: false,
                        timer: 1500
                    });
                } else if (response.status === 401) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Phiên hết hạn',
                        text: 'Vui lòng đăng nhập lại để tiếp tục.',
                        confirmButtonColor: '#5563DE'
                    });
                } else {
                    return response.json().then(errorData => {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: errorData.message || 'Có lỗi xảy ra.',
                        });
                    });
                }
            })
            .catch(error => {
                console.error('Lỗi:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Mất kết nối',
                    text: 'Không thể liên lạc với máy chủ.',
                });
            })
            .finally(() => {
                button.disabled = false;
                button.innerHTML = originalText;
            });
        }
    </script>
}
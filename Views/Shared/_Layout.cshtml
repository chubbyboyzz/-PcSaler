                                <div class="slider-bar" id="sliderBar"></div>
                                <div class="slider-knob" id="sliderKnob">
                                    <i class="fa-solid fa-arrow-right"></i>
                                </div>
                                <div class="text-center pt-2 text-muted small user-select-none" style="position:absolute; width:100%; top:0; pointer-events:none;">
                                    Kéo sang phải để ghép hình
                                </div>
                            </div>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - PCShop</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)

    <style>
        /* Modal Login Style */
        .login-modal-header { background: linear-gradient(135deg, #5563DE, #74ABE2); color: white; }
        .btn-custom-login { background: #5563DE; color: white; font-weight: 600; transition: all 0.3s; }
        .btn-custom-login:hover { background: #3c48b5; color: white; transform: translateY(-2px); }
        .btn-custom-login:disabled { background: #6c757d; cursor: not-allowed; transform: none; }
        .form-control:focus { border-color: #5563DE; box-shadow: 0 0 0 0.2rem rgba(85, 99, 222, 0.25); }

        /* Floating Buttons Style */
        .floating-contact-group {
            position: fixed; bottom: 30px; right: 20px; z-index: 99999;
            display: flex; flex-direction: column-reverse; gap: 15px;
        }
        .contact-btn {
            width: 55px; height: 55px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2); transition: all 0.3s ease; text-decoration: none; cursor: pointer; background-color: #fff;
        }
        .contact-btn:hover { transform: scale(1.1); }
        .btn-zalo { border: 2px solid #0068FF; background: #fff; overflow: hidden; }
        .btn-mess { background: linear-gradient(45deg, #00B2FF, #006AFF); color: white; font-size: 30px; border: none; }
        .btn-hotline { background-color: #dc3545; color: white; font-size: 24px; border: 2px solid white; }

        /* Header Custom */
        .navbar-nav .nav-link { font-weight: 600; text-transform: uppercase; font-size: 0.9rem; color: #444; }
        .navbar-nav .nav-link:hover { color: #5563DE; }

        /* --- SLIDER CAPTCHA CSS --- */
        .captcha-container { position: relative; width: 300px; height: 150px; margin: 0 auto 15px; background: #f2f2f2; border-radius: 4px; overflow: hidden; }
        .captcha-bg { width: 100%; height: 100%; display: block; }
        .captcha-piece { position: absolute; top: 0; left: 0; width: 45px; height: 45px; z-index: 2; box-shadow: 0 0 10px rgba(0,0,0,0.5); }
        
        .slider-container { position: relative; width: 300px; margin: 0 auto 20px; height: 40px; background: #eee; border-radius: 20px; box-shadow: inset 0 0 5px rgba(0,0,0,0.1); }
        .slider-bar { position: absolute; left: 0; top: 0; height: 40px; border-radius: 20px; background: #d1e7dd; width: 0; }
        .slider-knob { position: absolute; left: 0; top: 0; width: 50px; height: 40px; background: #fff; border: 1px solid #ccc; border-radius: 20px; cursor: pointer; box-shadow: 0 2px 5px rgba(0,0,0,0.2); display: flex; align-items: center; justify-content: center; transition: background 0.2s; z-index: 3; }
        .slider-knob:hover { background: #f8f9fa; }
        .slider-knob i { color: #555; }
    </style>
</head>

<body class="d-flex flex-column vh-100">

    <header class="bg-white sticky-top shadow-sm">
        <div class="container py-3">
            <div class="row align-items-center gy-3">
                <div class="col-6 col-lg-3">
                    <a class="navbar-brand fw-bold fs-3 text-primary d-flex align-items-center" href="@Url.Action("Index", "Home")">
                        <i class="fa-solid fa-computer me-2"></i>PCShop
                    </a>
                </div>

                <div class="col-12 col-lg-5 order-last order-lg-0">
                    @await Component.InvokeAsync("SearchMenu", new { currentQuery = Context.Request.Query["q"].ToString() })
                </div>

                <div class="col-6 col-lg-4 d-flex justify-content-end align-items-center gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <a class="btn btn-outline-light text-dark border-0 d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown">
                                <div class="fs-4"><i class="fa-regular fa-circle-user"></i></div>
                                <div class="text-start d-none d-xl-block" style="line-height: 1.2;">
                                    <small class="text-muted" style="font-size: 11px;">Xin chào</small><br>
                                    <span class="fw-bold small">@User.Identity.Name</span>
                                </div>
                            </a>
                             <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li><a class="dropdown-item" href="@Url.Action("Profile", "Customers")"><i class="fa-solid fa-id-card me-2"></i>Hồ sơ</a></li>
                                <li><hr class="dropdown-divider"></li>
                                 <li>
                                     <form method="post" action="@Url.Action("Logout", "Login")">
                                        <button type="submit" class="dropdown-item text-danger"><i class="fa-solid fa-right-from-bracket me-2"></i>Đăng xuất</button>
                                     </form>
                                </li>
                            </ul>
                         </div>
                    }
                    else
                    {
                        <a href="#" class="btn btn-outline-light text-dark border-0 d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#loginModal">
                            <div class="fs-4"><i class="fa-regular fa-user"></i></div>
                            <div class="text-start d-none d-xl-block" style="line-height: 1.2;">

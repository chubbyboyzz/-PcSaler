                            <a href="javascript:void(0)" onclick="openForgotModal()" class="text-decoration-none text-primary">Quên mật khẩu?</a>
                         </div>
                        <div class="d-grid mb-3"><button type="submit" id="btnLoginSubmit" class="btn btn-custom-login py-2 rounded-pill">ĐĂNG NHẬP</button></div>
                        <div class="text-center position-relative my-4"><hr class="text-muted"><span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">Hoặc đăng nhập bằng</span></div>
                        <div class="d-grid"><a href="@Url.Action("LoginByGoogle", "Login")" class="btn btn-outline-danger py-2 rounded-pill fw-bold"><i class="fa-brands fa-google me-2"></i> Google</a></div>
                   </form>
                </div>
                <div class="modal-footer justify-content-center bg-light border-0"><small>Chưa có tài khoản? <a asp-controller="Account" asp-action="Register" class="fw-bold text-decoration-none" style="color: #5563DE">Đăng ký ngay</a></small></div>
            </div>
        </div>

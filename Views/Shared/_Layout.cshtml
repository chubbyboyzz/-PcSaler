                                 <span class="fw-bold small">Đăng nhập</span>
                            </div>
                        </a>
                    }

                    <div class="ms-2">
                        @await Component.InvokeAsync("CartMenu")
                    </div>
                 </div>
            </div>
        </div>

        <div class="border-top">
            <div class="container">
                <nav class="navbar navbar-expand-lg navbar-light p-0">
                     <div class="dropdown me-3">
                        <button class="btn btn-primary rounded-0 fw-bold px-4 py-2 d-flex align-items-center gap-2" 
                               type="button" id="categoryDropdownMenu" data-bs-toggle="dropdown">
                             <i class="fa-solid fa-bars"></i> DANH MỤC
                        </button>
                        <div class="dropdown-menu shadow-lg border-0 mt-0 w-100" aria-labelledby="categoryDropdownMenu">
                             @await Component.InvokeAsync("CategoryMenu")
                          </div>
                    </div>

                    <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                        <span class="navbar-toggler-icon"></span>
                     </button>

                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><a class="nav-link px-3 active" href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                            <li class="nav-item"><a class="nav-link px-3" href="@Url.Action("Index", "PcBuild")">Bộ PC</a></li>
                            <li class="nav-item"><a class="nav-link px-3" href="@Url.Action("Accessories", "Product")">Phụ kiện</a></li>
                            <li class="nav-item"><a class="nav-link px-3 text-danger" href="@Url.Action("Promotion", "Pages")">Khuyến mãi</a></li>
                            <li class="nav-item"><a class="nav-link px-3 text-danger" href="@Url.Action("Contact", "Pages")">Liên Hệ</a></li>
                            <li class="nav-item"><a class="nav-link px-3 text-danger" href="@Url.Action("Warranty", "Pages")">Bảo Hành</a></li>
                        </ul>

                        <div class="py-2 py-lg-0">
                            <a href="javascript:void(0)" onclick="checkLoginForPcBuild()" class="btn btn-warning fw-bold text-dark rounded-pill px-3 shadow-sm">
                                <i class="fa-solid fa-screwdriver-wrench me-1"></i> Xây dựng PC
                            </a>
                        </div>
                    </div>
                </nav>
            </div>
        </div>
    </header>


    <div class="modal fade" id="forgotPassModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
             <div class="modal-content border-0 shadow-lg" style="border-radius: 15px; overflow: hidden;">
                <div class="modal-header border-0 text-white" style="background: linear-gradient(135deg, #ff7e5f, #feb47b);">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-key me-2"></i>LẤY LẠI MẬT KHẨU</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="fp-step-0" class="text-center">
                        <p class="text-muted mb-4">Bạn muốn tìm lại tài khoản bằng cách nào?</p>
                        <div class="d-grid gap-3">
                            <button class="btn btn-outline-primary py-2 fw-bold" onclick="showStep('email')"><i class="fa-solid fa-envelope me-2"></i> Dùng Email đăng ký</button>
                            <button class="btn btn-outline-secondary py-2 fw-bold" onclick="showStep('username')"><i class="fa-solid fa-user me-2"></i> Dùng Tên đăng nhập</button>
                        </div>
                    </div>
                    <div id="fp-step-email" style="display:none">
                        <div class="d-flex justify-content-between mb-3"><a href="javascript:void(0)" onclick="backToStep0()" class="text-muted small"><i class="fa-solid fa-arrow-left"></i> Quay lại</a></div>
                        <div class="form-floating mb-3"><input type="email" class="form-control" id="fpEmail" placeholder="Email"><label>Nhập Email</label></div>
                        <button class="btn btn-warning w-100 fw-bold text-white py-2" onclick="sendOtp('EMAIL')">GỬI MÃ OTP</button>
                     </div>
                     <div id="fp-step-username" style="display:none">
                        <div class="d-flex justify-content-between mb-3"><a href="javascript:void(0)" onclick="backToStep0()" class="text-muted small"><i class="fa-solid fa-arrow-left"></i> Quay lại</a></div>
                        <div class="form-floating mb-3"><input type="text" class="form-control" id="fpUsernameInput" placeholder="User"><label>Nhập Tên đăng nhập</label></div>
                        <button class="btn btn-info w-100 fw-bold text-white py-2" onclick="checkUsername()">TÌM TÀI KHOẢN</button>
                     </div>
                     <div id="fp-step-userinfo" style="display:none; text-align:center;">
                        <div class="mb-4"><h5 class="fw-bold text-primary" id="lblFullName">User</h5><p class="text-muted small">Email: <strong id="lblMaskedEmail">...</strong></p></div>
                        <button class="btn btn-primary w-100 fw-bold py-2" onclick="sendOtp('USERNAME')">ĐÚNG LÀ TÔI - GỬI OTP</button>
                        <div class="mt-3"><a href="javascript:void(0)" onclick="showStep('username')" class="text-muted small">Nhập lại</a></div>
                     </div>
                     <div id="fp-step-otp" style="display:none">
                        <p class="text-muted small mb-3">Mã OTP đã gửi. Kiểm tra email.</p>
                        <div class="form-floating mb-3"><input type="text" class="form-control text-center fw-bold" id="fpOtp" maxlength="6" style="letter-spacing:5px; font-size:1.2rem;"><label>Nhập OTP</label></div>
                        <button class="btn btn-primary w-100 fw-bold py-2" onclick="verifyOtp()">XÁC NHẬN</button>
                     </div>
                     <div id="fp-step-reset" style="display:none">
                        <p class="text-success small fw-bold">Thành công! Nhập mật khẩu mới.</p>
                        <div class="form-floating mb-3"><input type="password" class="form-control" id="fpNewPass" placeholder="Pass"><label>Mật khẩu mới</label></div>
                        <button class="btn btn-success w-100 fw-bold py-2" onclick="doResetPass()">ĐỔI MẬT KHẨU</button>
                      </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
    
    <script>
        var isUserLoggedIn = @(User.Identity?.IsAuthenticated.ToString().ToLower() ?? "false");

        // 1. LOGIC PC BUILD
        function checkLoginForPcBuild() {
            if (isUserLoggedIn) { window.location.href = '@Url.Action("Index", "CustomersPC")'; }
            else {
                Swal.fire({
                    title: 'Yêu cầu đăng nhập', text: "Bạn cần đăng nhập để lưu cấu hình!", icon: 'info',
                    showCancelButton: true, confirmButtonColor: '#5563DE', cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Đăng nhập ngay', cancelButtonText: 'Chỉ xem thôi'
                }).then((result) => {
                    if (result.isConfirmed) {
                        const returnUrlInput = document.querySelector('#ajaxLoginForm input[name="returnUrl"]');
                        if (returnUrlInput) returnUrlInput.value = '/CustomersPC';
                        new bootstrap.Modal(document.getElementById('loginModal')).show();
                    }
                });
            }
        }

        // 2. CART COUNT
        function updateHeaderCartCount() {
            const countElement = document.getElementById('cart-count');
            if (countElement) { 
                if (isUserLoggedIn) {
                    fetch('/api/APICart/count').then(res => res.json()).then(count => { countElement.innerText = `(${count})`; }).catch(err => console.error(err));
                } else {
                    const cart = JSON.parse(localStorage.getItem('guest_cart')) || [];
                    const totalCount = cart.reduce((sum, item) => sum + (item.Quantity || item.quantity || 0), 0);
                    countElement.innerText = `(${totalCount})`;
                }
            }
        }
        document.addEventListener('DOMContentLoaded', updateHeaderCartCount);

        // 3. SET RETURN URL LOGIN
        document.addEventListener('DOMContentLoaded', function() {
            const returnUrlInput = document.querySelector('#ajaxLoginForm input[name="returnUrl"]');
            if(returnUrlInput && window.location.pathname !== '/CustomersPC') {
                returnUrlInput.value = window.location.pathname + window.location.search;
            }
        });

        // ==========================================
        // 4. LOGIC SLIDER CAPTCHA (KÉO THẢ)
        // ==========================================
        let isDragging = false;
        let startX = 0;

        const loginModalEl = document.getElementById('loginModal');
        if (loginModalEl) {
            loginModalEl.addEventListener('shown.bs.modal', loadCaptcha);
        }

        async function loadCaptcha() {
            const knob = document.getElementById('sliderKnob');
            const piece = document.getElementById('captchaPiece');
            const bar = document.getElementById('sliderBar');
            const verifiedInput = document.getElementById('isCaptchaVerified');

            if(!knob || !piece || !bar) return;

            knob.style.left = '0px';
            piece.style.left = '0px';
            bar.style.width = '0px';
            verifiedInput.value = "false";
            
            knob.innerHTML = '<i class="fa-solid fa-arrow-right"></i>';
            knob.style.background = "#fff";
            knob.style.cursor = "pointer";

            try {
                const res = await fetch('/Captcha/GetCaptchaImage');
                if (!res.ok) throw new Error("Lỗi load ảnh");
                const data = await res.json();
                
                document.getElementById('captchaBg').src = data.bg;
                document.getElementById('captchaPiece').src = data.piece;
                document.getElementById('captchaPiece').style.top = data.y + 'px';
            } catch (e) { console.error(e); }
        }

        const sliderKnob = document.getElementById('sliderKnob');
        if(sliderKnob) {
            sliderKnob.addEventListener('mousedown', startDrag);
            sliderKnob.addEventListener('touchstart', startDrag);
            window.addEventListener('mouseup', stopDrag);
            window.addEventListener('touchend', stopDrag);
            window.addEventListener('mousemove', doDrag);
            window.addEventListener('touchmove', doDrag);
        }

        function startDrag(e) {
            if (document.getElementById('isCaptchaVerified').value === "true") return;
            isDragging = true;
            startX = e.clientX || e.touches[0].clientX;
        }

        function doDrag(e) {
            if (!isDragging) return;
            const clientX = e.clientX || e.touches[0].clientX;
            let moveX = clientX - startX;
            const maxMove = 250;
            if (moveX < 0) moveX = 0;
            if (moveX > maxMove) moveX = maxMove;

            const knob = document.getElementById('sliderKnob');
            const piece = document.getElementById('captchaPiece');
            const bar = document.getElementById('sliderBar');

            knob.style.left = moveX + 'px';
            bar.style.width = moveX + 'px';
            piece.style.left = moveX + 'px';
        }

        async function stopDrag(e) {
            if (!isDragging) return;
            isDragging = false;

            const knob = document.getElementById('sliderKnob');
            const currentX = parseInt(knob.style.left);

            try {
                const res = await fetch('/Captcha/Verify', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ x: currentX })
                });
                const data = await res.json();
                
                if (data.success) {
                    document.getElementById('isCaptchaVerified').value = "true";
                    knob.innerHTML = '<i class="fa-solid fa-check text-success"></i>';
                    knob.style.background = "#d1e7dd";
                    knob.style.cursor = "default";
                    
                    // Tự động đăng nhập sau 0.5s
                    setTimeout(() => { handleAjaxLogin(null); }, 500);

                } else {
                    loadCaptcha();
                    knob.style.background = "#f8d7da";
                    setTimeout(() => knob.style.background = "#fff", 300);
                }
            } catch (e) {
                console.error(e);
                loadCaptcha();
            }
        }

        // ==========================================
        // 5. AJAX LOGIN HANDLER (ĐÃ NÂNG CẤP COUNTDOWN)
        // ==========================================
        async function handleAjaxLogin(event) {
            if(event) event.preventDefault();
            
            const captchaVerified = document.getElementById('isCaptchaVerified').value === "true";
            const captchaArea = document.getElementById('captchaArea');
            const submitBtn = document.getElementById('btnLoginSubmit');
            const originalText = "ĐĂNG NHẬP";

            // BƯỚC 1: NẾU CHƯA CAPTCHA THÌ HIỆN RA
            if (!captchaVerified) {
                const user = document.getElementById('modalUser').value;
                const pass = document.getElementById('modalPass').value;
                
                if(!user || !pass) {
                    return Swal.fire('Thông báo', 'Vui lòng nhập tài khoản và mật khẩu trước!', 'warning');
                }

                if (captchaArea.style.display === 'none') {
                    captchaArea.style.display = 'block';
                    loadCaptcha();
                }
                return;
            }

            // BƯỚC 2: GỬI REQUEST
            const form = document.getElementById('ajaxLoginForm');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang xử lý...';

            try {
                const response = await fetch('/Login/Index', { method: 'POST', body: new FormData(form) });
                const data = await response.json();

                if (data.success) {
                    Swal.fire({ icon: 'success', title: 'Thành công!', timer: 1500, showConfirmButton: false })
                    .then(() => { window.location.href = data.redirectUrl; });
                } 
                else if (data.isLocked) {
                    // --- XỬ LÝ KHÓA (COUNTDOWN) ---
                    Swal.fire({ icon: 'error', title: 'Tạm khóa', text: data.message });
                    
                    // Reset Captcha bắt làm lại
                    loadCaptcha();
                    document.getElementById('isCaptchaVerified').value = "false";
                    
                    // Bắt đầu đếm ngược trên nút
                    let timeLeft = data.remainingTime;
                    submitBtn.classList.add('btn-secondary');
                    submitBtn.classList.remove('btn-custom-login');
                    
                    // Xóa interval cũ nếu có
                    if (window.loginCountdownInterval) clearInterval(window.loginCountdownInterval);

                    window.loginCountdownInterval = setInterval(() => {
                        timeLeft--;
                        submitBtn.innerHTML = `<i class="fa-solid fa-ban"></i> Thử lại sau ${timeLeft}s`;
                        
                        if (timeLeft <= 0) {
                            clearInterval(window.loginCountdownInterval);
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = originalText;
                            submitBtn.classList.remove('btn-secondary');
                            submitBtn.classList.add('btn-custom-login');
                        }
                    }, 1000);
                } 
                else {
                    // Lỗi sai pass bình thường
                    loadCaptcha();
                    // document.getElementById('isCaptchaVerified').value = "false"; (loadCaptcha đã reset rồi)
                    
                    Swal.fire({ icon: 'error', title: 'Thất bại', html: data.message });
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            } catch (error) {
                Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Lỗi kết nối server.' });
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        }

        // 6. FORGOT PASSWORD LOGIC
        let fpContext = { email: "", username: "" };
        function openForgotModal() {
            const loginModal = bootstrap.Modal.getInstance(document.getElementById('loginModal'));
            if (loginModal) loginModal.hide();
            new bootstrap.Modal(document.getElementById('forgotPassModal')).show();
            backToStep0();
        }
        function backToStep0() { hideAllSteps(); document.getElementById('fp-step-0').style.display = 'block'; fpContext = { email: "", username: "" }; }
        function showStep(stepName) { hideAllSteps(); document.getElementById('fp-step-' + stepName).style.display = 'block'; }
        function hideAllSteps() { ['0', 'email', 'username', 'userinfo', 'otp', 'reset'].forEach(s => document.getElementById('fp-step-' + s).style.display = 'none'); }

        async function checkUsername() {
            const username = document.getElementById('fpUsernameInput').value;
            if (!username) return Swal.fire('Lỗi', 'Chưa nhập user', 'warning');
            const btn = event.target; const oldHtml = btn.innerHTML;
            btn.innerHTML = 'Đang tìm...'; btn.disabled = true;
            try {
                const fd = new FormData(); fd.append('username', username);
                const res = await fetch('/Login/CheckUserInfo', { method: 'POST', body: fd });
                const data = await res.json();
                if (data.success) {
                    document.getElementById('lblFullName').innerText = data.fullName;
                    document.getElementById('lblMaskedEmail').innerText = data.maskedEmail;
                    fpContext.username = username; showStep('userinfo');
                } else { Swal.fire('Lỗi', data.message, 'error'); }
            } catch (e) { Swal.fire('Lỗi', 'Lỗi kết nối', 'error'); } 
            finally { btn.innerHTML = oldHtml; btn.disabled = false; }
        }

        async function sendOtp(method) {
            let apiUrl = '', formData = new FormData();
            const btn = event.target; const oldHtml = btn.innerHTML;
            btn.innerHTML = 'Đang gửi...'; btn.disabled = true;
            if (method === 'EMAIL') {
                const email = document.getElementById('fpEmail').value;
                if(!email) { btn.disabled=false; btn.innerHTML=oldHtml; return Swal.fire('Lỗi','Nhập email','warning'); }
                fpContext.email = email;
                apiUrl = '/Login/SendOtp'; formData.append('email', email);
            } else if (method === 'USERNAME') {
                apiUrl = '/Login/SendOtpByUsername';
                formData.append('username', fpContext.username);
            }
            try {
                const res = await fetch(apiUrl, { method: 'POST', body: formData });
                const data = await res.json();
                if (data.success) { Swal.fire('OK', 'Đã gửi OTP', 'success'); showStep('otp'); } 
                else { Swal.fire('Lỗi', data.message, 'error'); }
            } catch (e) { Swal.fire('Lỗi', 'Lỗi kết nối', 'error'); }
            finally { btn.innerHTML = oldHtml; btn.disabled = false; }
        }

        async function verifyOtp() {
            const otp = document.getElementById('fpOtp').value;
            if(!otp) return Swal.fire('Lỗi','Nhập OTP','warning');
            const fd = new FormData(); fd.append('otp', otp);
            if (fpContext.username) fd.append('username', fpContext.username); else fd.append('email', fpContext.email);
            try {
                const res = await fetch('/Login/VerifyOtp', { method: 'POST', body: fd });
                const data = await res.json();
                if (data.success) showStep('reset'); else Swal.fire('Sai mã', data.message, 'error');
            } catch(e) { Swal.fire('Lỗi', 'Lỗi kết nối', 'error'); }
        }

        async function doResetPass() {
            const newPass = document.getElementById('fpNewPass').value;
            if (newPass.length < 8) return Swal.fire('Yếu', 'Pass phải >= 8 ký tự', 'warning');
            const strongRegex = new RegExp("^(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[!@@#\\$%\\^&\\*])");
            if (!strongRegex.test(newPass)) return Swal.fire('Yếu', 'Cần có chữ hoa, số và ký tự đặc biệt', 'warning');

            const fd = new FormData();
            fd.append('newPassword', newPass);
            if (fpContext.username) fd.append('username', fpContext.username); else fd.append('email', fpContext.email);
            try {
                const res = await fetch('/Login/ResetPassword', { method: 'POST', body: fd });
                const data = await res.json();
                if (data.success) Swal.fire('Xong', 'Đổi pass thành công', 'success').then(() => location.reload());
                else Swal.fire('Lỗi', data.message, 'error');
            } catch(e) { Swal.fire('Lỗi', 'Lỗi kết nối', 'error'); }
        }
    </script>
</body>
</html>